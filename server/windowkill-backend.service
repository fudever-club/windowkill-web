# Sample systemd unit for windowkill-backend.
#
# This file is a TEMPLATE — it is NOT enabled automatically.
# To use it:
#   1. Copy to /etc/systemd/system/windowkill-backend.service
#   2. Replace USER, GROUP and /home/USER paths below
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now windowkill-backend

[Unit]
Description=WINDOWKILL Web Edition — optional backend API
After=network.target

[Service]
Type=simple
User=USER
Group=GROUP
WorkingDirectory=/home/USER/workspace/windowkill-web/server
# No build step, no dependencies: plain node.
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5

# --- configuration via environment ---
Environment=PORT=3001
Environment=HOST=127.0.0.1
Environment=WK_DB=/home/USER/workspace/windowkill-web/server/data/windowkill.db
# Allow the static frontend origin(s), comma-separated. Leave empty for same-origin only.
# Environment=WK_CORS_ORIGINS=http://localhost:8080

# --- hardening ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/USER/workspace/windowkill-web/server/data

[Install]
WantedBy=multi-user.target
