# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly ensure all source and config files use LF
*.js text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.webmanifest text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.mp3 binary
*.mp4 binary
*.ico binary
