{
  "author": "fudever-club",
  "description": "Fan-made Windowkill-inspired web game — twin-stick shooter where the popup window IS your health bar",
  "license": "MIT",
  "main": "main.js",
  "name": "windowkill-web",
  "productName": "WINDOWKILL Web Edition",
  "version": "1.2.0",
  "scripts": {
    "stage": "node ../scripts/build-electron.js",
    "start": "node ../scripts/build-electron.js && electron .",
    "pack": "node ../scripts/build-electron.js && electron-packager . windowkill-web --platform=win32 --arch=x64 --asar --icon=assets/icon.ico --out=dist --overwrite --ignore=\"^/(tests|dist)\"",
    "release": "node ../scripts/build-electron.js && electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.fudever.windowkill",
    "productName": "WINDOWKILL Web Edition",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "win-ops.js",
      "package.json",
      "app/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "WINDOWKILL-Web-Edition-Portable-x64.exe"
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.18.0"
  }
}
